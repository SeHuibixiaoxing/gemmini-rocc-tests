deep_log_path=/root/pipeline-runtime-debug/bertmini-batch8.deep.log
audit_log_path=/root/pipeline-runtime-debug/bertmini-batch8.audit.log
checkpoint_log_path=/root/pipeline-runtime-debug/bertmini-batch8.checkpoint.log
breadcrumb_path=/root/pipeline-runtime-debug/bertmini-batch8.breadcrumb.bin
status_path=/root/pipeline-runtime-debug/bertmini-batch8.status
runner_early_stage_path=/root/pipeline-runtime-debug/bertmini-batch8.runner-early.stage
runner_stage_path=/root/pipeline-runtime-debug/bertmini-batch8.runner.stage
runner_proc_stage_path=/root/pipeline-runtime-debug/bertmini-batch8.runner-proc.stage
wrapper_stage_path=/root/pipeline-runtime-debug/bertmini-batch8.wrapper.stage
wrapper_proc_stage_path=/root/pipeline-runtime-debug/bertmini-batch8.wrapper-proc.stage
trace_dir=/root/pipeline-runtime-debug/traces
profile_id=pairdummy-sbus64-dummy8x8-fixed-v2
periodic_sync_enable=1
periodic_sync_seconds=1
progress_ping_enable=0
progress_ping_seconds=30
child_proc_poll_seconds=5
uart_log_enable=0
guest_log_enable=1
