CC ?= gcc
CFLAGS ?= -O2 -Wall -Wextra -Werror -std=c11 -D_POSIX_C_SOURCE=200809L
PIPELINE_RUNTIME_DEBUG_CFLAGS ?= -g3 -fno-omit-frame-pointer
CPPFLAGS ?= -D_GNU_SOURCE -Iinclude -I..
PIPELINE_RUNTIME_PROGRESS ?= 0
PIPELINE_RUNTIME_PROGRESS_RAW ?= 0
PIPELINE_RUNTIME_PROGRESS_HOT ?= 0
PIPELINE_RUNTIME_GEMMINI_PHASE ?= 0
PIPELINE_RUNTIME_ONLY_MARKER ?= 0
PIPELINE_RUNTIME_CRITICAL_UART_PROBE ?= 1
PIPELINE_RUNTIME_CRITICAL_UART_PAD_BURST ?= 0
PIPELINE_RUNTIME_PROGRESS_PAD_BURST ?= 0
PIPELINE_RUNTIME_MLOCKALL_MODE ?= 0
CPPFLAGS += -DPRT_ENABLE_PROGRESS_LOG=$(PIPELINE_RUNTIME_PROGRESS)
CPPFLAGS += -DPRT_ENABLE_PROGRESS_RAW_LOG=$(PIPELINE_RUNTIME_PROGRESS_RAW)
CPPFLAGS += -DPRT_ENABLE_PROGRESS_HOT_LOG=$(PIPELINE_RUNTIME_PROGRESS_HOT)
CPPFLAGS += -DPIPELINE_RUNTIME_GEMMINI_PHASE_LOG=$(PIPELINE_RUNTIME_GEMMINI_PHASE)
CPPFLAGS += -DPRT_ENABLE_ONLY_MARKER=$(PIPELINE_RUNTIME_ONLY_MARKER)
CPPFLAGS += -DPRT_ENABLE_CRITICAL_UART_PROBE=$(PIPELINE_RUNTIME_CRITICAL_UART_PROBE)
CPPFLAGS += -DPRT_ENABLE_CRITICAL_UART_PAD_BURST=$(PIPELINE_RUNTIME_CRITICAL_UART_PAD_BURST)
CPPFLAGS += -DPRT_ENABLE_PROGRESS_PAD_BURST=$(PIPELINE_RUNTIME_PROGRESS_PAD_BURST)
CPPFLAGS += -DPRT_MLOCKALL_MODE=$(PIPELINE_RUNTIME_MLOCKALL_MODE)
LDFLAGS ?=
LDLIBS ?= -lpthread

SRC := $(wildcard src/*.c)
OBJ := $(SRC:.c=.o)
BIN := pipeline_runtime
HEADERS := $(wildcard include/*.h ../include/*.h)

.PHONY: all clean

all: $(BIN)

$(BIN): $(OBJ)
	$(CC) $(CFLAGS) $(PIPELINE_RUNTIME_DEBUG_CFLAGS) $(OBJ) $(LDFLAGS) $(LDLIBS) -o $@

src/%.o: src/%.c $(HEADERS)
	$(CC) $(CPPFLAGS) $(CFLAGS) $(PIPELINE_RUNTIME_DEBUG_CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ) $(BIN)
