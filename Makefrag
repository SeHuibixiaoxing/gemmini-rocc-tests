XLEN ?= 64

CC_BAREMETAL := riscv$(XLEN)-unknown-elf-gcc

ifndef CC_LINUX
CC_LINUX_GNU_TOOLCHAIN := $(shell command -v riscv$(XLEN)-unknown-linux-gnu-gcc 2> /dev/null)
CC_LINUX_SYSTEM := $(shell command -v riscv$(XLEN)-linux-gnu-gcc 2> /dev/null)

# Support Linux gcc from riscv-gnu-toolchain and from system packages.
ifneq ($(strip $(CC_LINUX_GNU_TOOLCHAIN)),)
CC_LINUX := $(CC_LINUX_GNU_TOOLCHAIN)
else ifneq ($(strip $(CC_LINUX_SYSTEM)),)
CC_LINUX := $(CC_LINUX_SYSTEM)
else
CC_LINUX :=
endif
endif

ENV_P = $(abs_top_srcdir)/riscv-tests/env/p
ENV_V = $(abs_top_srcdir)/riscv-tests/env/v

.PHONY: all clean default

default: all
src_dir = .

clean:
	rm -rf $(junk)
